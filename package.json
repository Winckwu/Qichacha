{
  "name": "mca-system",
  "version": "1.0.0",
  "private": true,
  "description": "Metacognitive Collaborative Agent System",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:demo": "cd apps/demo && pnpm dev",
    "build": "pnpm -r build",
    "build:demo": "cd apps/demo && pnpm build",
    "preview:demo": "cd apps/demo && pnpm preview",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "db:migrate": "cd apps/api && pnpm prisma migrate dev",
    "db:studio": "cd apps/api && pnpm prisma studio",
    "db:generate": "cd apps/api && pnpm prisma generate"
  },
  "keywords": ["education", "ai", "metacognition"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
